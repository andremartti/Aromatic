# =============================================================================
#  Secretos de las funciones de servidor de AROMATIC (Supabase Edge Functions)
# =============================================================================
#  NO escriba valores reales en este archivo ni en el repositorio.
#  Cárguelos en Supabase: Project Settings → Edge Functions → Secrets
#  o con:  supabase secrets set --env-file supabase/functions/.env   (archivo local, ignorado por git)
#
#  SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_DB_URL los provee Supabase
#  automáticamente a las funciones desplegadas.
# =============================================================================

# Orígenes que pueden llamar a las funciones (la tienda publicada y, si quiere, el entorno local).
ALLOWED_ORIGINS=https://andremartti.github.io,http://localhost:3000

# URL pública de la tienda (enlaces de confirmación).
PUBLIC_SITE_URL=https://andremartti.github.io/Aromatic

# Secreto para firmar los enlaces privados de cada pedido. Mínimo 32 caracteres aleatorios.
# Genérelo con:  openssl rand -base64 48
ORDER_TOKEN_SECRET=

# Pagos: "test" (pruebas, sin cobros reales, pedidos marcados como PRUEBA) o "live" (cobros reales).
PAYMENTS_MODE=test

# Proveedor de tarjeta en modo test: "pixelpay" (sandbox oficial de PixelPay) o
# "simulated" (simulador interno, sin red). En modo live siempre es PixelPay.
CARD_PROVIDER=pixelpay

# PixelPay (credenciales del comercio, panel de PixelPay → Ajustes/API).
# En modo test, si se dejan vacías, se usan el endpoint y las credenciales públicas de sandbox
# del SDK oficial. En modo live: el endpoint que indique PixelPay (si se deja vacío, https://pixelpay.app).
PIXELPAY_ENDPOINT=
PIXELPAY_KEY_ID=
PIXELPAY_SECRET_KEY=

# Token aleatorio que se agrega a la URL del webhook (?k=...). Genérelo con: openssl rand -hex 24
PIXELPAY_WEBHOOK_TOKEN=

# "true" para pedir autenticación 3-D Secure en cada venta (si su afiliación lo incluye).
PIXELPAY_3DS=false

# Solo para proyectos con secreto JWT simétrico (HS256) o pruebas locales. Normalmente vacío.
AUTH_JWT_SECRET=
