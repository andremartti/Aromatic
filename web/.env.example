# Número de WhatsApp de AROMATIC en formato internacional, SOLO dígitos
# (código de país + número, sin "+", espacios ni guiones).
# Mientras esté vacío, el botón abre WhatsApp para que el cliente elija el contacto.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URL pública del sitio (sin barra final), para canonical, Open Graph, sitemap y
# datos estructurados. En GitHub Pages la define el workflow automáticamente.
NEXT_PUBLIC_SITE_URL=

# Tienda en línea y panel (/admin). Ambos valores son PÚBLICOS por diseño: la clave
# "anon" no da acceso a los datos (todo pasa por las funciones de servidor, con RLS).
# Supabase → Project Settings → API. Vacíos = sitio sin carrito (pedidos por WhatsApp).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo desarrollo local: apunta a las funciones servidas por supabase/tests/dev_server.ts
# (http://127.0.0.1:54321/functions/v1). En producción se deriva de NEXT_PUBLIC_SUPABASE_URL.
NEXT_PUBLIC_FUNCTIONS_URL=
